PORT=3000

# Deployment identity. Give every agency a unique slug, Compose project,
# database/volume set, URLs, and secrets. Do not change AGENCY_SLUG after launch.
AGENCY_SLUG=horizon
AGENCY_NAME=Horizon
AGENCY_LOGO_URL=
AGENCY_PRIMARY_COLOR="#0f766e"
AGENCY_QUOTATION_TEMPLATE=classic
AGENCY_PHONE=
AGENCY_EMAIL=
AGENCY_WEBSITE=
AGENCY_ADDRESS=
AGENCY_QUOTATION_FOOTER=Prices are indicative and subject to availability.

# WhatsApp lead session idle timeout (minutes). After this, the number starts fresh.
CONVERSATION_IDLE_MINUTES=5

# Comma-separated browser origins allowed to call the API (Vercel frontend)
# Example: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Public CRM URL used in customer WhatsApp/email quote links (/quote/:token).
# Required in production — do not leave this as localhost.
# Example: https://travel-kappa-navy.vercel.app
FRONTEND_URL=

# Wasender
WASENDER_API_KEY=your_api_key_here
WASENDER_WEBHOOK_SECRET=
WASENDER_BASE_URL=https://www.wasenderapi.com/api
# Prepend to local numbers without country code (e.g. 9876543210 -> +919876543210)
DEFAULT_PHONE_COUNTRY_CODE=91

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# WhatsApp voice notes -> text -> lead (processed in the `voice-messages` queue)
# Speech-to-text model. gpt-4o-transcribe is more accurate on Arabic / noisy audio.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Voice notes longer than this are declined (cost / abuse guard), in seconds.
VOICE_MAX_SECONDS=180
# Reply with 🎤 "<what was heard>" before processing, so mis-heard places/dates are caught.
VOICE_ECHO_TRANSCRIPT=true
# Keep at 1: two voice notes from one customer both update the same conversation.
VOICE_WORKER_CONCURRENCY=1
# Vision-capable model used to OCR PDF/image brochures & rate sheets.
# gpt-4.1-mini read every price on a 12-page test rate sheet correctly (gpt-4o-mini got ~7%
# of cells wrong) and was faster. Avoid reasoning models (gpt-5*): ~70s per brochure.
OPENAI_IMPORT_MODEL=gpt-4.1-mini
# A brochure is split into one package per hotel/offer, extracted in parallel.
# Parallel model calls per brochure (raise for speed, lower if you hit OpenAI rate limits).
BROCHURE_EXTRACT_CONCURRENCY=6
# Safety cap on packages created from one file (each is a paid model call).
BROCHURE_MAX_PACKAGES=40

# Postgres
# Local host app + docker-compose.dev.yml: localhost:55432
# VPS docker-compose.yml: overridden to postgres:5432 by Compose
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel

# Redis (BullMQ)
# Local: 127.0.0.1:56379
# VPS: overridden to redis:6379 by Compose
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
# Logical Redis database (0-15). Use a different one to isolate a dev/test run from a live worker.
REDIS_DB=0

# RapidAPI — Booking COM (booking-com15)
# Subscribe at https://rapidapi.com/DataCrawler/api/booking-com15
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=booking-com15.p.rapidapi.com
RAPIDAPI_BASE_URL=https://booking-com15.p.rapidapi.com/api/v1

# RapidAPI — Airbnb (airbnb19). Same RapidAPI account as the Airbnb MCP if Booking.com uses a different key.
# Subscribe at https://rapidapi.com/DataCrawler/api/airbnb19
RAPIDAPI_AIRBNB_KEY=your_rapidapi_airbnb_key_here
RAPIDAPI_AIRBNB_HOST=airbnb19.p.rapidapi.com
RAPIDAPI_AIRBNB_BASE_URL=https://airbnb19.p.rapidapi.com

# SerpApi — Google Flights, Google Flights Autocomplete,
# Google Hotels Autocomplete, and Google Images
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_HL=en
SERPAPI_GL=us
SERPAPI_TIMEOUT_MS=20000
# Round trips need a 2nd search per offer to resolve return legs (1 credit each).
# 0 disables return resolution and leaves offers outbound-only.
SERPAPI_FLIGHTS_RETURN_LOOKUPS=3
# Search a city's whole metro area when its airports lie within this many miles
# of the city, otherwise quote the nearest airport only.
# new york 12mi + london 35mi -> metro; dubai 66mi (Abu Dhabi) -> DXB only.
# 0 = always a single airport.
SERPAPI_FLIGHTS_METRO_MAX_MI=40
# Usage rights filter for auto-picked package/destination artwork.
# f = free to use or share, fmc = free to use commercially, empty = unfiltered.
SERPAPI_IMAGES_LICENSES=f

# Flight provider for the quote worker: auto | booking | google
# auto = Booking.com first, Google Flights fallback (only when SERPAPI_KEY is set)
FLIGHTS_PROVIDER=auto

# Hotelbeds API — used for hotel availability & rates
# Register at https://developer.hotelbeds.com
# Test: https://api.test.hotelbeds.com  |  Prod: https://api.hotelbeds.com
HOTELBEDS_API_KEY=your_hotelbeds_api_key_here
HOTELBEDS_SECRET=your_hotelbeds_secret_here
# Use https://api.hotelbeds.com for production
HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com

# Admin JWT auth
# Generate strong random secrets (different for access vs refresh), e.g.:
#   openssl rand -hex 32
# Public signup creates pending users. Configure the initial approving admin.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD_MIN_12_CHARS=
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REFRESH_COOKIE_NAME=refresh_token
# Must be a prefix of the browser path to the auth routes.
# Use `/` when VITE_API_URL includes a prefix (e.g. https://api.dimyon.ai/travel).
REFRESH_COOKIE_PATH=/
# Local Vite proxy (same-origin): COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
# Vercel frontend → separate HTTPS API host: COOKIE_SECURE=true, COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PASSWORD_MIN_LENGTH=8

# Cloudinary — image uploads for predefined quotes
# Create a cloud at https://cloudinary.com and copy the cloud name, API key, and API secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=travel/quotes

# Host port published by docker-compose.yml (VPS)
BACKEND_PORT=3000
# Public URL for WhatsApp PDF links (must be reachable by Wasender)
BACKEND_URL=http://localhost:3000

# Human takeover: hours after the last agent action before the WhatsApp bot answers again. Empty = never.
AI_AUTO_RESUME_HOURS=

# Staff assistant. Provider: openai (uses OPENAI_API_KEY) or anthropic (needs ANTHROPIC_API_KEY).
ASSISTANT_PROVIDER=openai
ASSISTANT_OPENAI_MODEL=
ANTHROPIC_API_KEY=
ASSISTANT_ANTHROPIC_MODEL=claude-sonnet-5-5
ASSISTANT_RATE_LIMIT_PER_MINUTE=20

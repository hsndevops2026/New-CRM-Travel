{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "db:migrate": "node -e \"import('./config/database.js').then(async ({ pingDb, pool }) => { const { runMigrations } = await import('./db/migrate.js'); await pingDb(); await runMigrations(); await pool.end(); })\"",
    "prod:up": "docker compose up -d --build",
    "prod:down": "docker compose down",
    "prod:logs": "docker compose logs -f backend"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^5.23.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "read-excel-file": "^9.3.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}

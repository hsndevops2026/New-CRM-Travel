# Copy to a private file such as agency-acme.env. Never commit the populated file.
# The same file is used for Compose interpolation and as the backend environment.
AGENCY_SLUG=acme-travel
AGENCY_NAME=Acme Travel
AGENCY_LOGO_URL=
AGENCY_PRIMARY_COLOR="#0f766e"
AGENCY_QUOTATION_TEMPLATE=classic

POSTGRES_USER=travel_acme
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
POSTGRES_DB=travel_acme
BACKEND_PORT=3101

FRONTEND_URL=https://acme-travel.example.com
BACKEND_URL=https://api-acme-travel.example.com
CORS_ORIGINS=https://acme-travel.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
REFRESH_COOKIE_PATH=/

INITIAL_ADMIN_EMAIL=admin@acme.example
INITIAL_ADMIN_PASSWORD_MIN_12_CHARS=REPLACE_WITH_UNIQUE_INITIAL_PASSWORD
JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_UNIQUE_RANDOM_SECRET

WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMPORT_MODEL=gpt-4o-mini
RAPIDAPI_KEY=
RAPIDAPI_AIRBNB_KEY=
SERPAPI_KEY=
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=travel/acme-travel/quotes

# Human takeover: hours after the last agent action before the WhatsApp bot answers again. Empty = never.
AI_AUTO_RESUME_HOURS=

# Staff assistant. Provider: openai (uses OPENAI_API_KEY) or anthropic (needs ANTHROPIC_API_KEY).
ASSISTANT_PROVIDER=openai
ASSISTANT_OPENAI_MODEL=
ANTHROPIC_API_KEY=
ASSISTANT_ANTHROPIC_MODEL=claude-sonnet-5-5
ASSISTANT_RATE_LIMIT_PER_MINUTE=20

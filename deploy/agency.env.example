# Copy to a private file such as agency-acme.env. Never commit the populated file.
# The same file is used for Compose interpolation and as the backend environment.
AGENCY_SLUG=acme-travel
AGENCY_NAME=Acme Travel
AGENCY_LOGO_URL=
AGENCY_PRIMARY_COLOR="#0f766e"
AGENCY_QUOTATION_TEMPLATE=classic

POSTGRES_USER=travel_acme
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
POSTGRES_DB=travel_acme
BACKEND_PORT=3101

FRONTEND_URL=https://acme-travel.example.com
BACKEND_URL=https://api-acme-travel.example.com
CORS_ORIGINS=https://acme-travel.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
REFRESH_COOKIE_PATH=/

INITIAL_ADMIN_EMAIL=admin@acme.example
INITIAL_ADMIN_PASSWORD_MIN_12_CHARS=REPLACE_WITH_UNIQUE_INITIAL_PASSWORD
JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_UNIQUE_RANDOM_SECRET

WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMPORT_MODEL=gpt-4o-mini
RAPIDAPI_KEY=
RAPIDAPI_AIRBNB_KEY=
SERPAPI_KEY=
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=travel/acme-travel/quotes

# Human takeover: hours after the last agent action before the WhatsApp bot answers again. Empty = never.
AI_AUTO_RESUME_HOURS=

# Staff Assistant (sidebar -> Assistant). Chat runs on Claude; images and video use OPENAI_API_KEY.
# Claude keys are normally added inside the app (Assistant -> Connections) and stored encrypted.
# A key here makes Claude available to all staff without that step. A claude.ai subscription
# cannot be used: it must be an API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Encrypts API keys and connector tokens saved from the app. Generate with: openssl rand -hex 32
# If empty, a key derived from JWT_REFRESH_SECRET is used; rotating that secret then makes
# saved keys unreadable and users must enter them again.
AI_KEYS_ENCRYPTION_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high (higher costs more per image).
OPENAI_IMAGE_QUALITY=medium
OPENAI_VIDEO_MODEL=sora-2
# Cloudinary folder for generated media. Without Cloudinary, files are kept in Postgres.
CLOUDINARY_ASSISTANT_FOLDER=travel/assistant
# Upper bound on one reply, and on model calls per message (tool use takes several).
ASSISTANT_MAX_TOKENS=64000
ASSISTANT_MAX_STEPS=8
# "off" stops declined requests from being re-run on Anthropic's fallback model.
ASSISTANT_REFUSAL_FALLBACK=on
ASSISTANT_RATE_LIMIT_PER_MINUTE=20

# Website chat widget (see docs/WEBCHAT.md). Comma-separated sites allowed to use it; empty = any site.
WEBCHAT_ALLOWED_ORIGINS=
WEBCHAT_RATE_LIMIT_PER_MINUTE=20

# Gmail for staff (Email page). See docs/DEPLOY-RENDER.md section 5.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Any long random value; encrypts stored Gmail tokens.
EMAIL_TOKEN_ENCRYPTION_KEY=
